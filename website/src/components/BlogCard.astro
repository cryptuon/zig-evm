---
export interface Props {
  title: string;
  description: string;
  pubDate: Date;
  tags: string[];
  slug: string;
  image?: string;
}

const { title, description, pubDate, tags, slug, image } = Astro.props;
const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class="card group">
  <a href={`${import.meta.env.BASE_URL}/blog/${slug}/`} class="block no-underline hover:no-underline">
    {image && (
      <div class="mb-4 overflow-hidden rounded-lg">
        <img src={image} alt={title} class="w-full h-48 object-cover transition-transform duration-300 group-hover:scale-105" loading="lazy" />
      </div>
    )}
    <div class="flex flex-wrap gap-2 mb-3">
      {tags.slice(0, 3).map(tag => (
        <span class="tag">{tag}</span>
      ))}
    </div>
    <h3 class="text-lg font-bold text-ctp-text mb-2 group-hover:text-ctp-blue transition-colors">
      {title}
    </h3>
    <p class="text-sm text-ctp-subtext0 leading-relaxed mb-4 line-clamp-3">
      {description}
    </p>
    <time datetime={pubDate.toISOString()} class="text-xs text-ctp-overlay1">
      {formattedDate}
    </time>
  </a>
</article>
