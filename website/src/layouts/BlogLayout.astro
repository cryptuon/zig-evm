---
import BaseLayout from './BaseLayout.astro';

export interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  author: string;
  tags: string[];
  image?: string;
  keywords?: string[];
  faq?: { question: string; answer: string }[];
}

const { title, description, pubDate, updatedDate, author, tags, image, keywords = [], faq } = Astro.props;

const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const updatedFormatted = updatedDate?.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const blogPostingSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  ...(updatedDate ? { dateModified: updatedDate.toISOString() } : {}),
  author: { '@type': 'Person', name: author },
  publisher: {
    '@type': 'Organization',
    name: 'Zig EVM',
    url: 'https://zig-evm.cryptuon.com/',
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': Astro.url.toString(),
  },
  ...(image ? { image } : {}),
  keywords: tags,
  articleSection: 'Technology',
};

const faqSchema = faq && faq.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(item => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
} : null;

const jsonLd = [blogPostingSchema, ...(faqSchema ? [faqSchema] : [])];

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Blog', url: '/blog/' },
  { name: title },
];
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  publishedTime={pubDate.toISOString()}
  modifiedTime={updatedDate?.toISOString()}
  author={author}
  tags={tags}
  keywords={keywords}
  image={image}
  jsonLd={jsonLd}
  breadcrumbs={breadcrumbs}
>
  <article class="py-12">
    <!-- Breadcrumbs -->
    <nav aria-label="Breadcrumb" class="mb-8">
      <ol class="flex items-center gap-2 text-sm text-ctp-subtext0">
        <li><a href={`${import.meta.env.BASE_URL}/`} class="hover:text-ctp-blue">Home</a></li>
        <li class="text-ctp-overlay0">/</li>
        <li><a href={`${import.meta.env.BASE_URL}/blog/`} class="hover:text-ctp-blue">Blog</a></li>
        <li class="text-ctp-overlay0">/</li>
        <li class="text-ctp-text">{title}</li>
      </ol>
    </nav>

    <!-- Header -->
    <header class="mb-10">
      <div class="flex flex-wrap gap-2 mb-4">
        {tags.map(tag => (
          <a href={`${import.meta.env.BASE_URL}/blog/tags/${tag}/`} class="tag no-underline hover:no-underline">
            {tag}
          </a>
        ))}
      </div>
      <h1 class="text-3xl md:text-4xl font-bold text-ctp-text mb-4 leading-tight">{title}</h1>
      <p class="text-lg text-ctp-subtext0 mb-6">{description}</p>
      <div class="flex items-center gap-4 text-sm text-ctp-subtext0">
        <span>By <strong class="text-ctp-text">{author}</strong></span>
        <span class="text-ctp-overlay0">|</span>
        <time datetime={pubDate.toISOString()}>{formattedDate}</time>
        {updatedFormatted && (
          <>
            <span class="text-ctp-overlay0">|</span>
            <span>Updated <time datetime={updatedDate!.toISOString()}>{updatedFormatted}</time></span>
          </>
        )}
      </div>
    </header>

    <!-- Content -->
    <div class="prose prose-invert max-w-none
      prose-headings:text-ctp-text prose-headings:font-bold
      prose-h2:text-2xl prose-h2:mt-12 prose-h2:mb-4 prose-h2:border-b prose-h2:border-ctp-surface1 prose-h2:pb-2
      prose-h3:text-xl prose-h3:mt-8 prose-h3:mb-3
      prose-p:text-ctp-subtext1 prose-p:leading-relaxed prose-p:mb-4
      prose-a:text-ctp-blue prose-a:no-underline hover:prose-a:underline
      prose-strong:text-ctp-text
      prose-ul:text-ctp-subtext1 prose-ol:text-ctp-subtext1
      prose-li:mb-1
      prose-blockquote:border-ctp-blue prose-blockquote:text-ctp-subtext0
      prose-code:text-ctp-peach
      prose-pre:bg-ctp-mantle prose-pre:border prose-pre:border-ctp-surface1
      prose-table:text-ctp-subtext1
      prose-th:text-ctp-text prose-th:border-ctp-surface1
      prose-td:border-ctp-surface1
    ">
      <slot />
    </div>

    <!-- FAQ Section (if present) -->
    {faq && faq.length > 0 && (
      <section class="mt-16 border-t border-ctp-surface1 pt-10">
        <h2 class="text-2xl font-bold text-ctp-text mb-8">Frequently Asked Questions</h2>
        <dl class="space-y-6">
          {faq.map(item => (
            <div class="card">
              <dt class="text-lg font-semibold text-ctp-text mb-2">{item.question}</dt>
              <dd class="text-ctp-subtext1 leading-relaxed">{item.answer}</dd>
            </div>
          ))}
        </dl>
      </section>
    )}

    <!-- CTA -->
    <div class="mt-16 rounded-xl bg-gradient-to-r from-ctp-blue/10 to-ctp-mauve/10 border border-ctp-surface1 p-8 text-center">
      <h3 class="text-xl font-bold text-ctp-text mb-3">Try Zig EVM</h3>
      <p class="text-ctp-subtext0 mb-6">Explore the interactive playground or dive into the source code.</p>
      <div class="flex justify-center gap-4">
        <a href={`${import.meta.env.BASE_URL}/playground/`} class="btn-primary">Open Playground</a>
        <a href="https://github.com/cryptuon/zig-evm" class="btn-secondary">View on GitHub</a>
      </div>
    </div>
  </article>
</BaseLayout>
