---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found"
  description="The page you're looking for doesn't exist."
  noindex={true}
>
  <div class="flex flex-col items-center justify-center py-32 text-center">
    <div class="text-8xl font-bold gradient-text mb-4">404</div>
    <h1 class="text-2xl font-bold text-ctp-text mb-4">Page Not Found</h1>
    <p class="text-ctp-subtext0 mb-8 max-w-md">
      The page you're looking for doesn't exist or has been moved. Maybe the bytecode jumped to an invalid destination.
    </p>
    <div class="flex gap-4">
      <a href={`${import.meta.env.BASE_URL}/`} class="btn-primary">Go Home</a>
      <a href={`${import.meta.env.BASE_URL}/blog/`} class="btn-secondary">Read the Blog</a>
    </div>
  </div>
</BaseLayout>
