---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/BlogCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const allTags = [...new Set(posts.flatMap(p => p.data.tags))].sort();

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Zig EVM Blog',
  description: 'Articles about EVM development, Zig programming, blockchain engineering, and parallel execution',
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: posts.map((post, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: new URL(`/blog/${post.slug}/`, Astro.site).toString(),
      name: post.data.title,
    })),
  },
};

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Blog' },
];
---

<BaseLayout
  title="Blog"
  description="Deep dives into EVM internals, Zig systems programming, parallel execution, and blockchain infrastructure. Learn how the Ethereum Virtual Machine works."
  jsonLd={collectionSchema}
  breadcrumbs={breadcrumbs}
  keywords={['EVM blog', 'Ethereum development', 'Zig programming', 'blockchain engineering']}
>
  <section class="py-12">
    <!-- Header -->
    <div class="mb-12">
      <h1 class="text-3xl md:text-4xl font-bold text-ctp-text mb-4">Blog</h1>
      <p class="text-lg text-ctp-subtext0 max-w-2xl">
        Deep dives into EVM internals, Zig systems programming, parallel transaction execution, and blockchain infrastructure.
      </p>
    </div>

    <!-- Tags -->
    {allTags.length > 0 && (
      <div class="mb-10 flex flex-wrap gap-2">
        <a href={`${import.meta.env.BASE_URL}/blog/`} class="tag bg-ctp-blue/20 no-underline hover:no-underline">All</a>
        {allTags.map(tag => (
          <a href={`${import.meta.env.BASE_URL}/blog/tags/${tag}/`} class="tag no-underline hover:no-underline">{tag}</a>
        ))}
      </div>
    )}

    <!-- Posts Grid -->
    {posts.length > 0 ? (
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {posts.map(post => (
          <BlogCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            tags={post.data.tags}
            slug={post.slug}
            image={post.data.image}
          />
        ))}
      </div>
    ) : (
      <div class="text-center py-20">
        <p class="text-ctp-subtext0 text-lg">Articles coming soon. Stay tuned!</p>
      </div>
    )}
  </section>
</BaseLayout>
