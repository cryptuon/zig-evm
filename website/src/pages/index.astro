---
import BaseLayout from '../layouts/BaseLayout.astro';

const homeSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareSourceCode',
  name: 'Zig EVM',
  description: 'High-performance, embeddable Ethereum Virtual Machine implementation in Zig with 96+ opcodes, parallel execution, and multi-language FFI bindings',
  codeRepository: 'https://github.com/cryptuon/zig-evm',
  programmingLanguage: ['Zig'],
  runtimePlatform: 'Ethereum Virtual Machine',
  license: 'https://opensource.org/licenses/MIT',
  operatingSystem: ['Linux', 'macOS', 'Windows'],
  applicationCategory: 'Blockchain Infrastructure',
  keywords: ['EVM', 'Ethereum', 'Zig', 'blockchain', 'virtual machine', 'bytecode', 'smart contracts'],
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Zig EVM',
  url: 'https://cryptuon.github.io/zig-evm/',
  logo: 'https://cryptuon.github.io/zig-evm/favicon.svg',
  sameAs: ['https://github.com/cryptuon/zig-evm'],
};

const features = [
  {
    icon: '&#x26A1;',
    title: '96+ Opcodes',
    description: 'Comprehensive EVM instruction set including arithmetic, stack, memory, flow control, and environmental opcodes.',
  },
  {
    icon: '&#x1F680;',
    title: 'Parallel Execution',
    description: 'Wave-based parallel transaction processing with 5-6x throughput improvement and work-stealing thread pools.',
  },
  {
    icon: '&#x1F517;',
    title: 'FFI Bindings',
    description: 'Native bindings for Python, Rust, JavaScript, and C. Embed the EVM in any language ecosystem.',
  },
  {
    icon: '&#x1F4B0;',
    title: 'Accurate Gas Metering',
    description: 'Realistic gas costs matching Ethereum specifications with per-opcode consumption and out-of-gas protection.',
  },
  {
    icon: '&#x1F9EA;',
    title: 'Interactive Playground',
    description: 'Browser-based bytecode editor with real-time disassembly, stack visualization, and execution tracing.',
  },
  {
    icon: '&#x2699;&#xFE0F;',
    title: 'Built with Zig',
    description: 'Zero-overhead abstractions, compile-time evaluation, and manual memory management for maximum performance.',
  },
];

const benchmarks = [
  { operation: 'Simple Transfer', ops: '45,000', time: '22\u00B5s' },
  { operation: 'Token Transfer', ops: '38,000', time: '26\u00B5s' },
  { operation: 'Complex Contract', ops: '12,000', time: '83\u00B5s' },
  { operation: 'Parallel (8 threads)', ops: '250,000', time: '4\u00B5s' },
];
---

<BaseLayout
  title="Home"
  description="High-performance, embeddable Ethereum Virtual Machine implementation in Zig. 96+ opcodes, parallel execution, FFI bindings for Python, Rust, JavaScript, and C."
  jsonLd={[homeSchema, orgSchema]}
  breadcrumbs={[{ name: 'Home' }]}
>
  <!-- Hero -->
  <section class="relative py-20 md:py-32 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-ctp-blue/5 via-transparent to-transparent pointer-events-none"></div>
    <div class="relative text-center max-w-4xl mx-auto">
      <div class="inline-flex items-center gap-2 rounded-full border border-ctp-surface2 bg-ctp-surface0 px-4 py-1.5 text-sm text-ctp-subtext0 mb-8">
        <span class="h-2 w-2 rounded-full bg-ctp-green animate-pulse"></span>
        Open Source &middot; MIT Licensed
      </div>
      <h1 class="text-4xl md:text-6xl lg:text-7xl font-bold leading-tight mb-6">
        <span class="gradient-text">Ethereum Virtual Machine</span>
        <br />
        <span class="text-ctp-text">Built in Zig</span>
      </h1>
      <p class="text-lg md:text-xl text-ctp-subtext0 max-w-2xl mx-auto mb-10 leading-relaxed">
        A high-performance, embeddable EVM implementation with 96+ opcodes, parallel transaction execution, and native bindings for Python, Rust, JavaScript, and C.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href={`${import.meta.env.BASE_URL}/playground/`} class="btn-primary text-lg px-8 py-4">
          Try the Playground
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
        </a>
        <a href="https://github.com/cryptuon/zig-evm" class="btn-secondary text-lg px-8 py-4">
          View on GitHub
        </a>
      </div>
    </div>
  </section>

  <!-- Quick Start -->
  <section class="py-16">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-sm font-semibold uppercase tracking-wider text-ctp-blue mb-4 text-center">Quick Start</h2>
      <div class="rounded-xl border border-ctp-surface1 bg-ctp-mantle overflow-hidden">
        <div class="flex items-center gap-2 px-4 py-3 border-b border-ctp-surface1">
          <div class="h-3 w-3 rounded-full bg-ctp-red/60"></div>
          <div class="h-3 w-3 rounded-full bg-ctp-yellow/60"></div>
          <div class="h-3 w-3 rounded-full bg-ctp-green/60"></div>
          <span class="ml-2 text-xs text-ctp-overlay0">terminal</span>
        </div>
        <pre class="p-6 text-sm overflow-x-auto"><code class="text-ctp-text"><span class="text-ctp-green">$</span> <span class="text-ctp-blue">git</span> clone https://github.com/cryptuon/zig-evm.git
<span class="text-ctp-green">$</span> <span class="text-ctp-blue">cd</span> zig-evm
<span class="text-ctp-green">$</span> <span class="text-ctp-blue">zig</span> build run
<span class="text-ctp-subtext0"># EVM initialized with 96 opcodes</span>
<span class="text-ctp-subtext0"># Gas used: 21000</span>
<span class="text-ctp-subtext0"># Execution complete</span></code></pre>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="py-20" id="features">
    <div class="text-center mb-14">
      <h2 class="text-3xl md:text-4xl font-bold text-ctp-text mb-4">Built for Performance</h2>
      <p class="text-lg text-ctp-subtext0 max-w-2xl mx-auto">
        Everything you need to execute, analyze, and debug EVM bytecode at maximum speed.
      </p>
    </div>
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {features.map(feature => (
        <div class="card">
          <div class="text-3xl mb-4" set:html={feature.icon} />
          <h3 class="text-lg font-bold text-ctp-text mb-2">{feature.title}</h3>
          <p class="text-sm text-ctp-subtext0 leading-relaxed">{feature.description}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Benchmarks -->
  <section class="py-20">
    <div class="text-center mb-14">
      <h2 class="text-3xl md:text-4xl font-bold text-ctp-text mb-4">Performance Benchmarks</h2>
      <p class="text-lg text-ctp-subtext0 max-w-2xl mx-auto">
        Measured on standard hardware. Parallel execution scales linearly up to 8 threads.
      </p>
    </div>
    <div class="max-w-3xl mx-auto">
      <div class="overflow-hidden rounded-xl border border-ctp-surface1">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-ctp-surface1 bg-ctp-surface0">
              <th class="px-6 py-4 text-left font-semibold text-ctp-text">Operation</th>
              <th class="px-6 py-4 text-right font-semibold text-ctp-text">Ops/sec</th>
              <th class="px-6 py-4 text-right font-semibold text-ctp-text">Avg Latency</th>
            </tr>
          </thead>
          <tbody>
            {benchmarks.map((row, i) => (
              <tr class:list={['border-b border-ctp-surface1 last:border-0', i % 2 === 1 ? 'bg-ctp-surface0/30' : '']}>
                <td class="px-6 py-4 text-ctp-text font-medium">{row.operation}</td>
                <td class="px-6 py-4 text-right text-ctp-green font-mono">{row.ops}</td>
                <td class="px-6 py-4 text-right text-ctp-peach font-mono">{row.time}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Multi-language Support -->
  <section class="py-20">
    <div class="text-center mb-14">
      <h2 class="text-3xl md:text-4xl font-bold text-ctp-text mb-4">Use From Any Language</h2>
      <p class="text-lg text-ctp-subtext0 max-w-2xl mx-auto">
        Native FFI bindings let you embed Zig EVM in your existing projects.
      </p>
    </div>
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
      {[
        { lang: 'Zig', color: 'text-ctp-peach', snippet: 'const evm = EVM.init(allocator);\nevm.execute(bytecode);' },
        { lang: 'Python', color: 'text-ctp-blue', snippet: 'from zigevm import EVM\nevm = EVM()\nevm.execute(bytecode)' },
        { lang: 'Rust', color: 'text-ctp-red', snippet: 'let evm = ZigEVM::new();\nevm.execute(&bytecode)?;' },
        { lang: 'JavaScript', color: 'text-ctp-yellow', snippet: "const { EVM } = require('zigevm');\nconst evm = new EVM();\nevm.execute(code);" },
      ].map(item => (
        <div class="card">
          <h3 class:list={['text-lg font-bold mb-3', item.color]}>{item.lang}</h3>
          <pre class="text-xs bg-ctp-base rounded-lg p-3 overflow-x-auto"><code class="text-ctp-subtext1">{item.snippet}</code></pre>
        </div>
      ))}
    </div>
  </section>

  <!-- Blog CTA -->
  <section class="py-20">
    <div class="rounded-2xl bg-gradient-to-r from-ctp-blue/10 via-ctp-mauve/10 to-ctp-pink/10 border border-ctp-surface1 p-10 md:p-16 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-ctp-text mb-4">Learn EVM Development</h2>
      <p class="text-lg text-ctp-subtext0 max-w-2xl mx-auto mb-8">
        Deep dives into EVM internals, Zig systems programming, parallel execution, and blockchain infrastructure.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href={`${import.meta.env.BASE_URL}/blog/`} class="btn-primary">Read the Blog</a>
        <a href={`${import.meta.env.BASE_URL}/rss.xml`} class="btn-secondary">
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19 7.38 20 6.18 20C5 20 4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1z"/></svg>
          RSS Feed
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
